# FlashForensics AI configuration
# Every setting has a working default. Copy to .env only if you want to change one.

# ---------------------------------------------------------------------------
# Language model (entirely optional)
#
# With no key set, the pipeline runs on its deterministic rule engine. That is
# the configuration the benchmark numbers in the README were measured under.
# A model improves the wording of explanations and handles ambiguous fragments
# the rules leave open; it is never required for correctness.
# ---------------------------------------------------------------------------
# FF_LLM_PROVIDER=auto            # auto | anthropic | openai | heuristic
# FF_ANTHROPIC_API_KEY=
# FF_OPENAI_API_KEY=
# FF_ANTHROPIC_MODEL=claude-sonnet-4-6
# FF_OPENAI_MODEL=gpt-4o-mini
# FF_LLM_MAX_FRAGMENTS=60         # cap on model-adjudicated fragments per run

# ---------------------------------------------------------------------------
# Analysis tuning
# ---------------------------------------------------------------------------
# FF_ENTROPY_BLOCK_SIZE=4096      # smaller finds finer damage, costs more time
# FF_CARVE_ALIGNMENT=0            # 0 follows the volume cluster size; 1 disables
# FF_MIN_CARVE_CONFIDENCE=0.35
# FF_MAX_FRAGMENT_BYTES=67108864

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# FF_API_HOST=0.0.0.0
# FF_API_PORT=8000
# FF_WORKSPACE=~/.flashforensics
# FF_MAX_UPLOAD_BYTES=8589934592

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
